# Environment Configuration for CFD Neural Network Pipeline
# Author: Aditya001-max <kaushikadityaraj001@gmail.com>

# Dataset & Simulation Paths
DATA_DIR=./data
SIMULATION_DATA_DIR=./data/simulation_data
XML_RUNS_DIR=./data/xml_runs

# Simulation Generation Parameters
NUM_SIMULATION_RUNS=2000
SIMULATION_QUEUE_WORKERS=8

# Neural Network Training Hyperparameters
BATCH_SIZE=32
EPOCHS=100
LEARNING_RATE=0.0001
TRAIN_TEST_SPLIT=0.8

# Model Checkpointing
CHECKPOINT_DIR=./saved_models
LOG_DIR=./logs

# Hardware & Accelerator Settings
CUDA_VISIBLE_DEVICES=0
TF_CPP_MIN_LOG_LEVEL=2
